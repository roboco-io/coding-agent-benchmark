# 랄프 루프 모델 벤치마크 설정 — setup.sh가 $HOME/experiments/ralph-exp$EXP/bench.env로 복사해 고정한다.
EXP=027                       # 실험 번호 (3자리)
HARNESS=codex                 # codex | claude-native | claude-direct | pi | agy
# 조건 목록: "<조건명>:<모델 ID>" 공백 구분. 조건명에는 '-' 금지 (run 이름 <조건>-<언어>-<n> 파싱용)
CONDITIONS="sol:gpt-6-sol luna:gpt-6-luna"
LANGS="en"                    # 기본 en만. ko·"en ko"는 사용자가 명시적으로 요청한 경우에만
N=3                           # 조건×언어당 반복 수
MAX_ITER=30                   # iteration 상한
MAX_SEC=1200                  # run당 wall-clock 상한(초, 기본 20분 — 2026-10-10 사용자 지시). iteration 도중에도 적용 — 도달 시 진행 중 iteration 종료(exit 125)
STALL_SEC=300                 # iteration 정체 한도(초, 2026-10-10부터 300). 세션 기록·실행 로그·앱 파일이 이 시간 동안 갱신되지 않으면 iteration을 종료(exit 124)하고 다음 iteration으로. 근거: EXP-020–036 세션 기록 간 최대 공백 8.4분
# 비용 상한 (필수, EXP-042 재발 방지 — 2 run에 약 $92 과금 사례). setup·smoke가 미설정이면 거부한다.
# 진행 중 30초마다 cost_guard.py로 추정해 넘으면 iteration을 종료(exit 126)하고 남은 run을 시작하지 않는다.
PRICE_IN=""                   # 100만 토큰당 입력 단가(USD, 공개 단가·확인일을 설계 문서에 기록). 구독 실행은 0
PRICE_OUT=""                  # 100만 토큰당 출력 단가(USD). 구독 실행은 0
PRICE_CACHE_READ=""           # 캐시 읽기 단가. 빈 값이면 입력 단가의 10%
PRICE_TIERS=""                # 입력 길이 구간 단가 "상한:입력:출력,..." (예: qwen3-coder-next "32000:0.30:1.50,128000:0.50:2.50,256000:0.80:4.00")
RUN_BUDGET_USD=2              # run 1개 추정 비용 상한
EXP_BUDGET_USD=10             # 실험 전체 추정 비용 상한 (설계 문서에 사전 등록하고 사용자 승인)
EFFORT=medium                 # codex: model_reasoning_effort (빈 값이면 모델 기본값) / agy: --effort (gemini는 필수: low|medium|high)
# claude-direct 전용 (제공자의 Anthropic 호환 엔드포인트 직결 — 변환 계층 금지)
BASE_URL=""                   # 예: https://api.deepseek.com/anthropic
AUTH_ENV=""                   # 키가 든 환경변수 이름 (예: DEEPSEEK_API_KEY). 값은 ~/.zsh_secrets에서 로드
# pi 전용 (pi coding agent, EXP-029). 조건 모델 ID는 "<provider>/<model>" (예: deepseek/deepseek-flash)
PI_BIN=""                     # pi 절대 경로 (예: $(npm prefix -g)/bin/pi)
PI_MODELS_JSON=""             # 내장 provider가 없는 제공자용 models.json (예: assets/pi-models.json). 빈 값이면 생략
PI_KEYMAP=""                  # pi가 읽는 키 env ← ~/.zsh_secrets 변수 (예: "MOONSHOT_API_KEY=KIMI_API_KEY")
PI_KEEP_ENV=""                # 에이전트 환경에 남길 키 env 이름 (내장 provider 기본 키, 예: DEEPSEEK_API_KEY). PI_KEYMAP 대상은 자동 포함. 그 외 ~/.zsh_secrets 값은 제거됨
THINKING=""                   # pi --thinking (빈 값이면 모델별 pi 기본값 — 세션 jsonl thinking_level_change로 기록)
# agy 전용 (Antigravity CLI, EXP-035). GEMINI_API_KEY(~/.zsh_secrets) + 격리 HOME의 modelProvider=gemini
AGY_BIN=""                    # agy 절대 경로 (예: $HOME/.local/bin/agy)
