#!/bin/sh
# 실험 report.md가 커밋에 포함되면 README의 실험 결과 섹션을 자동 재생성한다.
if git diff --cached --name-only | grep -q '^experiments/.*/report\.md$'; then
  python3 scripts/update_readme_results.py || exit 1
  git add README.md README.*.md
fi
# 보고서·i18n·비용·상세 원자료가 바뀌면 대시보드 아코디언 데이터(dashboard/details.js)를 재생성한다.
if git diff --cached --name-only | grep -qE '^(experiments/.*/report\.md|scripts/readme_i18n\.json|analysis/cost/cost_all_runs\.csv|analysis/dashboard-details/.*\.json)$'; then
  python3 scripts/build_dashboard_details.py || exit 1
  git add dashboard/details.js
fi
# API 키·토큰이 커밋에 들어가지 않도록 스테이징 내용 전체(위에서 자동 추가한 파일 포함)를 마지막에 검사한다.
# 압축 아카이브도 풀어서 검사한다 (EXP-029·036 세션 아카이브 키 유출 재발 방지).
python3 scripts/check_staged_keys.py || exit 1
